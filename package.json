{
  "name": "eth-room-schedule",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "build": "npm run check && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  }
}
